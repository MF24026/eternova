{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],

        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,

        // exactOptionalPropertyTypes: intentionally OFF.
        // Breaks third-party Vue 3 component prop types (e.g. Pinia, vue-router, lucide-vue-next).
        // verbatimModuleSyntax: intentionally OFF.
        // Forces `import type` everywhere which conflicts with normal Vue SFC patterns.

        "jsx": "preserve",
        "jsxImportSource": "vue",

        "paths": {
            "@/*": ["./resources/js/*"]
        },
        "baseUrl": ".",

        "isolatedModules": true,
        "skipLibCheck": true,

        "useDefineForClassFields": true,
        "allowImportingTsExtensions": true,
        "noEmit": true
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.vue"
    ],
    "exclude": [
        "node_modules",
        "public",
        "vendor",
        "tests/e2e/**"
    ]
}
