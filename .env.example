APP_NAME=Eternova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
# Single database, multi-tenant with tenant_id on all business tables.
# In dev, DB_HOST=mysql (Sail service name). In prod, use the real host.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=eternova
DB_USERNAME=sail
DB_PASSWORD=password

# ─── Session ──────────────────────────────────────────────────────────────────
# Use Redis for session in production (SESSION_DRIVER=redis).
# SESSION_DOMAIN must cover all tenant subdomains, e.g. .eternova.app in prod.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Cache & Queue ────────────────────────────────────────────────────────────
# Use Redis for both cache and queue in all environments.
# QUEUE_CONNECTION=sync only for local debugging without workers.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────────────────────────────────
# Use MAIL_MAILER=log in dev (the password-reset link lands in storage/logs).
# PILOT/PROD: switch to Resend (recommended for LatAm) — set MAIL_MAILER=resend
# and RESEND_API_KEY below. Without a real transport, password-reset and other
# transactional emails will NOT be delivered.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@eternova.app"
MAIL_FROM_NAME="${APP_NAME}"

# Resend transactional email (https://resend.com).
# Pilot/prod steps: 1) create a Resend account, 2) verify the sending domain
# (add the SPF/DKIM DNS records Resend gives you so MAIL_FROM_ADDRESS's domain is
# authenticated), 3) generate an API key and paste it here, 4) set MAIL_MAILER=resend.
RESEND_API_KEY=

# ─── OCR (Expenses module) ────────────────────────────────────────────────────
# OCR_DRIVER: 'tesseract' (default, self-hosted) | 'fake' (no Tesseract needed).
# Set to 'fake' if Tesseract is not installed locally or when running outside
# Docker. The test suite forces 'fake' regardless of this value.
# After adding Tesseract to the Docker image, rebuild with:
#   docker compose build laravel.test && docker compose up -d laravel.test
OCR_DRIVER=tesseract

# Path to the tesseract binary inside the container (rarely needs changing).
# TESSERACT_BINARY=tesseract

# Language pack(s) passed to Tesseract -l flag. 'spa+eng' covers LatAm receipts.
# TESSERACT_LANGUAGES=spa+eng

# Hard timeout (seconds) for a single Tesseract process call.
# TESSERACT_TIMEOUT_SECONDS=60

# ─── Catalog module ───────────────────────────────────────────────────────────
# Disk used to store product images (thumbnail/medium/full).
# Use "public" in dev (storage/app/public). In production set to "s3".
CATALOG_IMAGE_DISK=public

# ─── AWS S3 (Storage) ─────────────────────────────────────────────────────────
# Used for tenant file storage (images, receipts, PDFs) in production.
# In dev, FILESYSTEM_DISK=local stores under storage/app/tenants/{tenant_id}/.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Vite / Frontend ──────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
# SPA API base URL — consumed by Axios in resources/js/services/api.ts
# MUST be a relative path (not absolute) so Axios inherits the page origin,
# including the tenant subdomain. An absolute URL like http://localhost:8080/api/v1
# would send every request to the bare host, breaking subdomain tenant resolution
# (EnsureTenant reads the tenant from the Host header).
VITE_API_BASE_URL=/api/v1

# ─── Rate limiting (requests per minute) ──────────────────────────────────────
# Global API guard (per user/IP) and login brute-force guard (per email+IP).
# PROD: leave these UNSET to use the secure defaults (api=120, login=5).
# LOCAL/CI: raise them so dev + the e2e suite (many requests from one IP) are not
# throttled, e.g. RATE_LIMIT_API=100000 / RATE_LIMIT_LOGIN=100000.
# RATE_LIMIT_API=
# RATE_LIMIT_LOGIN=

# ─── Security headers ─────────────────────────────────────────────────────────
# Defensive response headers (CSP, HSTS, anti-clickjacking) are ON by default.
# CSP is strict in production (per-request Vite nonce) and auto-relaxed in local/
# CI so Debugbar + the Vite dev client work — no env change needed for dev.
# HSTS is only emitted over real TLS, so it stays inert on http dev even when on.
# Set CSP_ENABLED=false / HSTS_ENABLED=false only to debug a header conflict.
# CSP_ENABLED=true
# HSTS_ENABLED=true
# HSTS_MAX_AGE=31536000

# ─── Multi-tenancy ────────────────────────────────────────────────────────────
# TENANT_RESOLVER: subdomain | path | domain
# - subdomain (default, prod): {slug}.eternova.app
# - path (dev fallback): eternova.localhost:8080/t/{slug}/...
# - domain (enterprise): custom CNAME domains
TENANT_RESOLVER=subdomain
# Used by EnsureTenant middleware to know base domain for subdomain parsing.
TENANT_BASE_DOMAIN=eternova.app

# ─── Sanctum (Auth) ───────────────────────────────────────────────────────────
# Comma-separated list of domains allowed to use stateful (cookie) auth.
# In dev, include localhost + the Sail port. In prod, use the actual domains.
# See docs/architecture.md section 6.2 for full list.
SANCTUM_STATEFUL_DOMAINS="localhost,localhost:8080,127.0.0.1,127.0.0.1:8080,eternova.localhost,eternova.localhost:8080,*.eternova.localhost,*.eternova.localhost:8080"

# Comma-separated list of additional regex patterns appended to CORS allowed_origins_patterns.
# Use this for custom tenant domains (Sprint 10+) without modifying config/cors.php.
# Example: CORS_EXTRA_ORIGIN_PATTERNS=#^https://shop\.acme\.com$#,#^https://flowers\.cliente\.co$#
CORS_EXTRA_ORIGIN_PATTERNS=

# ─── Wompi (SaaS Billing) ─────────────────────────────────────────────────────
# Wompi processes Eternova SaaS subscription payments (not tenant sales).
# Keys are obtained from https://comercios.wompi.co (sandbox) or production.
# WOMPI_EVENTS_KEY is the webhook signature secret from the Wompi dashboard.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_KEY=
WOMPI_ENV=sandbox

# ─── Inventory ────────────────────────────────────────────────────────────────
# Global fallback threshold for low-stock alerts. Overridden per variant via
# product_variants.min_stock_alert, or per tenant via tenants.locale_extra['default_min_stock'].
INVENTORY_DEFAULT_MIN_STOCK=10

# ─── PDF (Quotations module) ──────────────────────────────────────────────────
# PDF_RENDERER: 'dompdf' (default, pure PHP, no extra system packages needed).
# Future: 'browsershot' (pixel-perfect Tailwind, requires chromium + node in image).
PDF_RENDERER=dompdf

# PDF_PAPER_SIZE: 'letter' (LatAm standard for SV/CO/MX) or 'a4'.
# PDF_PAPER_SIZE=letter

# PDF_ENABLE_REMOTE: allow DomPDF to fetch external URLs for images (e.g. CDN logos).
# Keep false (default) — local logos are embedded as base64 for speed + privacy.
# Set to true only if logo_url is a stable, public, fast CDN URL.
# PDF_ENABLE_REMOTE=false

# ─── Tesseract OCR ────────────────────────────────────────────────────────────
# Used for expense receipt scanning (issue S0-E1 does not add the service yet;
# the Tesseract container is added in a dedicated infra issue).
# TODO(issue TBD): add tesseract service to compose.yaml
TESSERACT_BINARY=/usr/bin/tesseract
TESSERACT_LANG=spa

# ─── Google OAuth (Social Login) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ─── Sail / Docker port remapping ─────────────────────────────────────────────
# Ports are remapped to avoid clashing with restaurant-inventory project on
# 80 / 3306 / 6379 / 5173.
APP_PORT=8080
FORWARD_DB_PORT=3308
FORWARD_REDIS_PORT=6381
VITE_PORT=5174

WWWUSER=1000
WWWGROUP=1000
SAIL_XDEBUG_MODE=off
