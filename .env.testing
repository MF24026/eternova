APP_NAME=Eternova
APP_ENV=testing
APP_KEY=base64:nMl9P5B3s8frFOLM1E8/evFPajJwTmAhbXmXFm60qOY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database ────────────────────────────────────────────────────────────────
# In CI, the MySQL service runs on 127.0.0.1 (not "mysql" which is the Sail
# service name). Local Sail dev uses DB_HOST=mysql in .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eternova_testing
DB_USERNAME=sail
DB_PASSWORD=password

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Cache & Queue ───────────────────────────────────────────────────────────
# array cache + sync queue keeps tests fast and self-contained.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

# ─── Redis ───────────────────────────────────────────────────────────────────
# In CI, Redis service runs on 127.0.0.1 (not "redis" which is the Sail name).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=test@eternova.app
MAIL_FROM_NAME=Eternova

# ─── Multi-tenancy ───────────────────────────────────────────────────────────
TENANT_RESOLVER=subdomain
TENANT_BASE_DOMAIN=eternova.app

# ─── Sanctum ─────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ─── Scribe API docs ─────────────────────────────────────────────────────────
SCRIBE_AUTH_DEFAULT_VALUE=test-token
